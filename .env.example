# Copy to .env and fill in. .env is git-ignored — never commit it.
# Used by `plotter ocr` / `plotter copy-page` (Claude vision OCR). Without a key the
# Tesseract fallback is used automatically.
ANTHROPIC_API_KEY=
# Model name for OCR (read from this variable — the code never hardcodes it), e.g. claude-opus-5-5
AI_MODEL=
